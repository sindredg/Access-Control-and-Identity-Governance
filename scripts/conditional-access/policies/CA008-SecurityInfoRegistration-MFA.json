{
  "displayName": "CA008-SecurityInfoRegistration-MFA",
  "state": "enabledForReportingButNotEnforced",
  "conditions": {
    "clientAppTypes": ["all"],
    "applications": {
      "includeUserActions": ["urn:user:registersecurityinfo"]
    },
    "users": {
      "includeUsers": ["All"],
      "excludeGroups": ["__BREAKGLASS_GROUP_ID__"]
    }
  },
  "grantControls": {
    "operator": "OR",
    "builtInControls": ["mfa"]
  }
}
